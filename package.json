{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run typecheck && bun run lint && bun run format && bun run build",
    "dev": "astro dev",
    "dev:network": "astro dev --host",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "astro preview",
    "preview:network": "astro preview --host",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "7.1.0-beta"
  }
}
