<dialog id="palette" aria-labelledby="palette-label">
  <h2 id="palette-label" class="sr-only">Search posts</h2>
  <input
    id="palette-input"
    class="palette-field"
    type="search"
    role="combobox"
    aria-expanded="true"
    aria-controls="palette-results"
    aria-autocomplete="list"
    placeholder="Search posts"
    autocomplete="off"
    spellcheck="false"
  />
  <p id="palette-count" class="sr-only" aria-live="polite"></p>
  <ul id="palette-results" class="palette-results" role="listbox" aria-label="Posts"></ul>
  <p id="palette-empty" class="palette-empty" hidden>No posts found.</p>
</dialog>
