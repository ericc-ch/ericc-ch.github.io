---
import "@fontsource-variable/plus-jakarta-sans/wght.css"
import "@fontsource-variable/jetbrains-mono/wght.css"
import sans from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2"
import Nav from "@components/Nav.astro"
import { SITE } from "@consts"
import { serializeSchema, structuredData, type ArticleMeta } from "@lib/schema"
import { utcDay } from "@lib/utils"
import "../styles/main.css"

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  ogImage?: string
  article?: ArticleMeta
}

const {
  title,
  description = SITE.DESCRIPTION,
  noindex = false,
  ogImage = "/og/home.png",
  article,
} = Astro.props

const pageTitle = title ?? SITE.NAME
const site = Astro.site ?? new URL(Astro.url.origin)
const canonical = new URL(Astro.url.pathname, site)
const ogImageUrl = new URL(ogImage, site)
const schema = structuredData({
  site,
  canonical,
  title: title ?? SITE.NAME,
  description,
  image: ogImageUrl,
  article,
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.NAME} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.NAME} href="/rss.xml" />

    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    {article && (
      <meta property="article:published_time" content={utcDay(article.published).toISOString()} />
    )}
    {article && (
      <meta
        property="article:modified_time"
        content={utcDay(article.modified ?? article.published).toISOString()}
      />
    )}
    {article?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={serializeSchema(schema)} />
    <script is:inline>
      ;(() => {
        const root = document.documentElement
        root.dataset.js = "1"

        let stored = null
        try {
          stored = localStorage.getItem("theme")
        } catch {
          stored = null
        }

        if (stored === "light" || stored === "dark") root.dataset.theme = stored
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <script is:inline>
      ;(() => {
        const root = document.documentElement
        const button = document.getElementById("theme-toggle")
        const query = window.matchMedia("(prefers-color-scheme: dark)")
        const current = () => root.dataset.theme ?? (query.matches ? "dark" : "light")

        const render = () => {
          if (!button) return
          const dark = current() === "dark"
          button.textContent = dark ? "Light" : "Dark"
          button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme")
        }

        render()

        button?.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark"
          root.dataset.theme = next
          try {
            localStorage.setItem("theme", next)
          } catch {
            /* storage is optional */
          }
          render()
        })

        query.addEventListener("change", () => {
          if (!root.dataset.theme) render()
        })
      })()
    </script>
  </body>
</html>
