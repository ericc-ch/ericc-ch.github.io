---
import { getCollection } from "astro:content"
import Base from "@layouts/Base.astro"
import { SITE, SOCIALS } from "@consts"
import { dateRange, formatDate } from "@lib/utils"

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())

const latest = posts.slice(0, 3)

const endOf = (value: Date | string) =>
  typeof value === "string" ? Number.POSITIVE_INFINITY : value.valueOf()

const work = (await getCollection("work"))
  .sort((first, second) => endOf(second.data.dateEnd) - endOf(first.data.dateEnd))
  .slice(0, 3)

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())
  .slice(0, 3)
---

<Base>
  <div class="wrap home">
    <section class="lede">
      <p>
        I'm a software engineer. Mostly frontend, sometimes the other side of it, still in
        JavaScript. Lately that means browsers, developer tooling, and open source.
      </p>
      <p>
        Right now I'm building <a href="https://github.com/ericc-ch/tinybrowser">tinybrowser</a>, a
        headless browser for AI agents. I write about what I learn <a href="/posts/">here</a>.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Latest posts</h2>
      <ul class="entry-list">
        {latest.map((post) => <li>
          <a href={`/posts/${post.id}/`}>
            <span>{post.data.title}</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </a>
        </li>)}
      </ul>
      <p class="more"><a href="/posts/">All posts</a></p>
    </section>

    <section class="section">
      <h2 class="section-title">Work</h2>
      <ul class="entry-list">
        {work.map((entry) => <li>
          <div class="entry-main">
            <span>{entry.data.company}</span>
            <span class="entry-when">
              {dateRange(entry.data.dateStart, entry.data.dateEnd)}
            </span>
          </div>
          <span class="entry-detail">{entry.data.role}</span>
        </li>)}
      </ul>
    </section>

    <section class="section">
      <h2 class="section-title">Projects</h2>
      <ul class="entry-list">
        {projects.map((project) => <li>
          <div class="entry-main">
            <a href={project.data.repoURL ?? project.data.demoURL ?? "/posts/"}>
              {project.data.title}
            </a>
          </div>
          <span class="entry-detail">{project.data.description}</span>
        </li>)}
      </ul>
    </section>

    <section class="section">
      <h2 class="section-title">Elsewhere</h2>
      <ul class="inline-list">
        {SOCIALS.map((social) => <li>
          <a href={social.HREF} rel="me">
            {social.NAME}
          </a>
        </li>)}
        <li><a href={`mailto:${SITE.EMAIL}`}>email</a></li>
      </ul>
    </section>
  </div>
</Base>
